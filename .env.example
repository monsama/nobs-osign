# NOBS OSign server: non-secret settings. Written by deploy-nobs-osign.sh; edit here, then: sudo ./deploy-nobs-osign.sh
# The connections below are easier to set in the editor, signed in as admin: Settings → Server connections.
# What is saved there wins; what is left empty there comes from here.
# Secrets (admin password, LDAP service password, Graph client secret, Cloudflare token) live in ./secrets, not here.
# What each one is: docs/SETUP.md, "The editor on a server".

OSIGN_HOST=osign.example.ch
# Updates: 1 stops an update whose attestation cannot be checked (needs the GitHub CLI, gh auth login).
# OSIGN_REQUIRE_ATTESTATION=1
# The editor says when a newer version is out (twice a day one request to GitHub, nothing comes in); 0 is off:
# OSIGN_UPDATE_CHECK=0
# The time zone of the daily AD export (IANA name)
TZ=Europe/Zurich

# Sign-in: members of OSIGN_LDAP_GROUP (as a DN, nested groups count), with their Windows password
# OSIGN_LDAP_URL=ldaps://dc01.example.ch
# OSIGN_LDAP_BIND={login}@example.ch
# OSIGN_LDAP_BASE=OU=Users,DC=example,DC=ch
# OSIGN_LDAP_GROUP=CN=OSign-Admins,OU=Groups,DC=example,DC=ch
# A CA certificate for the domain controller, copied to ./certificates/ldap-ca.pem:
# OSIGN_LDAP_CA=/run/osign-certs/ldap-ca.pem
# A domain controller set in the editor uses 389, 636, 3268 or 3269; another port only when allowed here:
# OSIGN_LDAP_PORTS=10636

# Values from AD: a read-only service account (its password in secrets/ldap_service_password)
# OSIGN_LDAP_SERVICE_DN=CN=svc-osign,OU=Service,DC=example,DC=ch
# OSIGN_LDAP_DIRECTORY_BASE=DC=example,DC=ch
# Export the users' values every day at this time:
# OSIGN_AD_EXPORT_AT=06:00

# Publishing into SharePoint: the app registration "NOBS OSign server". The setup script gives it the server's own
# certificate (kept in the data volume); only without that, a client secret in secrets/graph_client_secret.
# OSIGN_GRAPH_TENANT_ID=
# OSIGN_GRAPH_CLIENT_ID=
# When its client secret runs out (YYYY-MM-DD): the editor warns 30 days before.
# OSIGN_GRAPH_CLIENT_SECRET_EXPIRES=

# The add-in's files to Cloudflare Pages (the token, "Cloudflare Pages: Edit", in secrets/cf_api_token)
# OSIGN_CF_ACCOUNT_ID=
# OSIGN_CF_PROJECT=company-osign
