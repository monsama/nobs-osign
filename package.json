    "server": "node server/index.js"
  },
  "dependencies": {
    "@azure/msal-browser": "4.26.1",
    "@noble/hashes": "1.8.0",
    "ldapjs": "3.0.7"
  },
  "devDependencies": {
    "esbuild": "0.25.11",
    "jsdom": "26.1.0",
    "playwright": "1.56.1"
  },
